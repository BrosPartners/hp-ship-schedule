{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/data/:path*", "destination": "/data/:path*" },
    { "source": "/js/:path*", "destination": "/web/js/:path*" },
    { "source": "/app.css", "destination": "/web/app.css" },
    { "source": "/", "destination": "/web/index.html" }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=1800" }]
    }
  ]
}
